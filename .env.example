# ML development only: distinct Docker project, ports and volumes.
COMPOSE_PROJECT_NAME=job-market-data-platform-ml
DB_HOST_PORT=15434
AIRFLOW_HOST_PORT=18081

# Copy to .env and replace every placeholder before starting Docker.
DB_PASSWORD=replace-with-your-local-database-password
AIRFLOW_JWT_SECRET=replace-with-a-long-random-secret
AIRFLOW_API_SECRET_KEY=replace-with-another-long-random-secret
MAX_REJECTED_PERCENT=10

# Optional Azure upload: enable only after configuring the private raw container.
# OPRIT upload Azure: false. PORNIT: true (poate consuma stocare/credit).
# Copiaza alegerea in .env; nu publica secretele.
AZURE_UPLOAD_ENABLED=false
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER=raw
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

AZURE_PROCESSED_CONTAINER=processed
