{
  "name": "job_market_free_edition",
  "email_notifications": {
    "no_alert_for_skipped_runs": false
  },
  "webhook_notifications": {},
  "timeout_seconds": 0,
  "schedule": {
    "quartz_cron_expression": "47 15 19 * * ?",
    "timezone_id": "Europe/Bucharest",
    "pause_status": "PAUSED"
  },
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "process_job_market",
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "<NOTEBOOK_PATH>",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "disabled": false
    }
  ],
  "queue": {
    "enabled": true
  },
  "performance_target": "PERFORMANCE_OPTIMIZED"
}
