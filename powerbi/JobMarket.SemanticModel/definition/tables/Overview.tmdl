table Overview
	lineageTag: 5c69d930-4356-4f52-88b0-29b64245c1ef

	measure 'Joburi colectate' = SUM(Overview[total_jobs])
		formatString: #,0
		lineageTag: d6822849-b07d-4650-9925-14790bf29071

	measure Companii = SUM(Overview[total_companies])
		formatString: #,0
		lineageTag: 372348f9-1a74-42f7-8c70-c45ae7748fd6

	measure 'Cu salariu' = SUM(Overview[jobs_with_salary])
		formatString: #,0
		lineageTag: bc51672a-d549-4889-84b6-e008aa5fcf9c

	measure 'Acoperire salarii' = DIVIDE(SUM(Overview[jobs_with_salary]),SUM(Overview[total_jobs]))
		formatString: 0.0%
		lineageTag: 199fcba7-9c9d-4707-9193-00fb6f491266

	column total_jobs
		dataType: int64
		formatString: 0
		lineageTag: 74eded76-2b06-4c6d-804a-7433cb3ef2df
		summarizeBy: none
		sourceColumn: total_jobs

	column total_companies
