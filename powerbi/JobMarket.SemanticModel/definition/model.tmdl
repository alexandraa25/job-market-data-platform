model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Overview","Roles","Companies","Skills","Salaries","RoleFilter","UsePostgreSQL"]

annotation PBI_ProTooling = ["DevMode"]

ref table Overview
ref table Roles
ref table Companies
ref table Skills
ref table Salaries
ref table RoleFilter

