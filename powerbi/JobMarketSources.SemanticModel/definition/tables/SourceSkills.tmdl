table SourceSkills
	lineageTag: 4993f5c2-2dd3-4ae7-804a-f5a143d21ffb

	measure 'Anunturi cu competenta' = SUM(SourceSkills[job_count])
		formatString: #,0
		lineageTag: a3fb0681-ba21-4151-b38f-fd1dfbc14399

	measure 'Cerere competenta' = IF(ISINSCOPE(SourceSkills[skill]), DIVIDE(SUM(SourceSkills[job_count]), SUM(SourceRoles[job_count])))
		formatString: 0.0%
		lineageTag: 61643389-140f-4860-9692-5fe87907d4e5

	column source
		dataType: string
		lineageTag: 140224c5-7503-4f43-ab11-a39436d47754
		summarizeBy: none
		sourceColumn: source

	column primary_role
		dataType: string
		lineageTag: 96b99245-dba8-44a5-b206-6a200781a5b0
		summarizeBy: none
		sourceColumn: primary_role

	column skill
		dataType: string
		lineageTag: 1b1c4470-d63b-4727-ace7-ca91830198ff
		summarizeBy: none
		sourceColumn: skill

	column job_count
		dataType: int64
		lineageTag: d23d5276-0ecf-492c-8fa0-2bb83d3cb659
		summarizeBy: none
		sourceColumn: job_count

	partition SourceSkills = m
		mode: import
